# local | postgres
DATABASE_DRIVER=local
# Required when DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://moarix:change-me@localhost:5432/moarix
# Alternatively set DATABASE_HOST/PORT/NAME/USER/PASSWORD separately (recommended for Compose)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=moarix
# DATABASE_USER=moarix
# DATABASE_PASSWORD=change-me
# Used only by the PostgreSQL migration/provisioning process when requested
DATABASE_APP_USER=moarix_app
DATABASE_APP_PASSWORD=LocalOnly-App-Database-42!

# Change in every non-development environment (32+ random characters)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Choose exactly one mode: false/true for trusted local HTTP, true/false for HTTPS.
COOKIE_SECURE=false
# Test/trusted LAN HTTP only; never use this pair on an internet-facing deployment.
ALLOW_INSECURE_COOKIES=true

# Optional: seed demo credentials for local evaluation only
SEED_DEMO_EMAIL=admin@moarix.local
SEED_DEMO_PASSWORD=LocalOnly-ChangeMe-42!

# Optional dependency-free operations CLI (never pass this token in argv)
MOARIX_URL=http://localhost:3000
MOARIX_TOKEN=
MOARIX_TIMEOUT_MS=30000
