# local | postgres
DATABASE_DRIVER=local
# Required when DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://moarix:change-me@localhost:5432/moarix

# Change in every non-development environment (32+ random characters)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Secure cookies are automatic in production. Set true behind HTTPS if needed.
COOKIE_SECURE=false

# Optional: seed demo credentials for local evaluation only
SEED_DEMO_EMAIL=admin@moarix.local
SEED_DEMO_PASSWORD=LocalOnly-ChangeMe-42!
