{
  "name": "moarix",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "멀티테넌트 영업·구매·재고와 Stratus 자산·점검·서비스 운영 ERP",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rls": "node --import tsx scripts/postgres-rls-smoke.ts",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "test:e2e": "npm run prepare:standalone && playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "smoke": "node --import tsx scripts/smoke.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.2",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
